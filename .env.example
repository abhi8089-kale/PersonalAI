# ===========================================================================
# PersonalAI — Environment Configuration Template
# Copy this file to .env and configure your desired AI provider.
# NEVER commit your actual .env file or real secrets to Git!
# ===========================================================================

# ---------------------------------------------------------------------------
# PROVIDER RECIPE 1: OpenAI (Official)
# ---------------------------------------------------------------------------
# 1. Get key at: https://platform.openai.com/api-keys
# OPENAI_API_KEY=sk-proj-...
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=

# ---------------------------------------------------------------------------
# PROVIDER RECIPE 2: Groq (Ultra-Fast & Free Tier Available)
# ---------------------------------------------------------------------------
# 1. Get free key at: https://console.groq.com/keys
# OPENAI_API_KEY=gsk_...
# OPENAI_MODEL=llama-3.3-70b-versatile
# OPENAI_BASE_URL=https://api.groq.com/openai/v1

# ---------------------------------------------------------------------------
# PROVIDER RECIPE 3: Google Gemini (Generous Free Tier via OpenAI Endpoint)
# ---------------------------------------------------------------------------
# 1. Get key at: https://aistudio.google.com/apikey
# OPENAI_API_KEY=AIzaSy...
# OPENAI_MODEL=gemini-2.5-flash
# OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# ---------------------------------------------------------------------------
# PROVIDER RECIPE 4: Ollama (100% Local, Free, No API Key Required)
# ---------------------------------------------------------------------------
# 1. Run in terminal: ollama run llama3.1
# OPENAI_API_KEY=ollama
# OPENAI_MODEL=llama3.1
# OPENAI_BASE_URL=http://localhost:11434/v1

# ---------------------------------------------------------------------------
# ACTIVE CONFIGURATION (Set your active values below)
# ---------------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=

# Optional SQLite Database Path override (defaults to personal_ai.db in root)
PERSONAL_AI_DB_PATH=
